# Copy to .env and fill in the two required secrets. Never commit .env.
#
# Generate each secret with (any machine with Python 3):
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Required -------------------------------------------------------------------
# Fernet key that encrypts every stored token, PAT and password (32 bytes, url-safe base64).
TT_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Signs the JWT access and refresh tokens. At least 32 characters.
TT_JWT_SECRET=replace-with-a-long-random-secret

# --- Key rotation (see README.md) -------------------------------------------------
# During a rotation: the previous TT_ENCRYPTION_KEY. Leave empty otherwise.
TT_ENCRYPTION_KEY_OLD=

# --- Optional (defaults shown) --------------------------------------------------
TT_DATABASE_URL=postgresql+psycopg://tt:tt@db:5432/tickettrail
TT_REDIS_URL=redis://redis:6379/0
TT_ALLOW_REGISTRATION=true
TT_ALLOW_PRIVATE_HOSTS=false
TT_GIT_TIMEOUT=300
TT_MIN_SCHEDULE_MINUTES=5
TT_AZURE_MAX_CONCURRENCY=5
TT_LOG_LEVEL=INFO
# The address users open. Cookies get the Secure flag only when this starts with https://.
TT_PUBLIC_URL=http://localhost:8080

# Host port the frontend is published on (compose only).
TT_HTTP_PORT=8080
